# Copy file nay thanh .env truoc khi chay docker compose:
# cp .env.example .env (Linux/macOS) hoac copy .env.example .env (Windows)

# Model serving configuration
MODEL_NAME=wdbc_breast_cancer_model
MODEL_VERSION=latest

# Postgres — MLflow Backend Store
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# MinIO — MLflow Artifact Store
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MLFLOW_BUCKET=mlflow

MINIO_IMAGE=quay.io/minio/minio:latest

UID_GID=0
